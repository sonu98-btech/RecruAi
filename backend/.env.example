NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/ai_calling_crm

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=accessToken

# Cookie flags (secure must be true behind HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Super admin bootstrap (used by npm run seed)
SEED_SUPER_ADMIN_NAME=Platform Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@recruai.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMeNow!123

# Mail (optional — logs to console if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Calling CRM <noreply@recruai.local>

# Twilio placeholders (do not put real secrets in git)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://api.example.com

# Future local AI / RAG
STT_PROVIDER=stub
LLM_PROVIDER=demo
TTS_PROVIDER=stub
VECTOR_DB_URL=
